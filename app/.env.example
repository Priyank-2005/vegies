# Copy to .env and edit. NEVER commit .env. All values below are DEV-ONLY placeholders.

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Dev Postgres (see README: `npm run db:start` starts a private cluster on port 5433)
HH_DATABASE_URL=postgres://postgres@127.0.0.1:5433/harihaat_dev
HH_TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5433/harihaat_test

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Session cookie
SESSION_COOKIE_NAME=hh_staff_session
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Customer OTP delivery: "console" (dev: prints to server log) | "disabled"
OTP_PROVIDER=console
# Order messages: "fake" only records them locally (read them on the order page in the admin panel); "disabled" queues without sending.
NOTIFY_CHANNEL=fake

# Dev seed only (npm run db:seed). Never use these values anywhere real.
SEED_OWNER_EMAIL=owner@example.test
SEED_OWNER_PASSWORD=

# Address lookup. nominatim = free public OpenStreetMap service, DEVELOPMENT / very low volume only (refused in production).
# Use none to disable. Choose a production geocoder before launch (see DECISIONS D-040).
# Address search keys: only for the provider you choose. Put them here in your own .env, never in chat or in git.
# OLA_MAPS_API_KEY=
# GOOGLE_MAPS_API_KEY=
GEOCODER_PROVIDER=nominatim
GEOCODER_USER_AGENT=HariHaat-dev/0.1
